# Documentation only: FastAPI reads OS environment variables, not .env automatically.
# Never commit real credentials. Run local demos on 127.0.0.1 only.
AGENTSHIELD_MODE=redact
AGENTSHIELD_ALLOW_MODE_OVERRIDE=false
# AGENTSHIELD_API_KEYS=<generate-a-unique-strong-token>
AGENTSHIELD_VAULT_DB=./agentshield_vault.db
AGENTSHIELD_VAULT_KEY_FILE=./.agentshield_vault.key
AGENTSHIELD_AUDIT_LOG=./agentshield_audit.jsonl
# OPENAI_API_KEY=<optional-provider-key>
# ANTHROPIC_API_KEY=<optional-provider-key>
